    "Advanced defensive stats (pressures, coverage allowed, missed tackles) publish once Pro-Football-Reference posts them for this season, usually within the first month. Until then defenders are ranked on production.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Advanced defensive stats (pressures, coverage allowed, missed tackles) publish once Pro-Football-Reference posts them for this season, usually within the first month. Until then defenders are ranked on production."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las estadísticas defensivas avanzadas (presiones, pases permitidos y tacleadas fallidas) llegan cuando Pro-Football-Reference las publica, normalmente durante el primer mes. Hasta entonces, los defensivos se ordenan por producción."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erweiterte Defensivwerte erscheinen meist im ersten Monat, sobald Pro-Football-Reference sie veröffentlicht. Bis dahin richtet sich die Rangliste nach der Leistung."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geavanceerde verdedigingsstatistieken verschijnen meestal in de eerste maand zodra Pro-Football-Reference ze publiceert. Tot die tijd wordt gerangschikt op productie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le statistiche difensive avanzate arrivano quando Pro-Football-Reference le pubblica, di solito entro il primo mese. Fino ad allora la classifica si basa sulla produzione."
          }
        }
      }
    },
