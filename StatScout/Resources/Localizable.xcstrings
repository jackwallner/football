    "The current season needs a connection for its first update. Once it has loaded, your saved stats are here offline.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current season needs a connection for its first update. Once it has loaded, your saved stats are here offline."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La temporada actual necesita conexión para la primera actualización. Después, tus estadísticas guardadas estarán disponibles sin conexión."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für das erste Update der aktuellen Saison brauchst du eine Verbindung. Danach sind gespeicherte Stats offline verfügbar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor de eerste update van dit seizoen is verbinding nodig. Daarna kun je opgeslagen statistieken offline bekijken."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La stagione attuale richiede una connessione per il primo aggiornamento. Poi le statistiche salvate sono disponibili offline."
          }
        }
      }
    },
    "The final score is in. Player stats usually post within a few hours of the final whistle.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The final score is in. Player stats usually post within a few hours of the final whistle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya está el marcador final. Las estadísticas suelen llegar unas horas después del silbatazo final."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Endstand ist da. Spieler-Stats folgen meist wenige Stunden nach dem Abpfiff."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De eindscore staat. Spelerstatistieken volgen meestal binnen een paar uur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
