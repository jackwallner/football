        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcadores, líderes y tendencias de la liga en segundos, con los datos detrás de cada partido."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ergebnisse, Spitzenreiter und Trends der Liga in Sekunden, mit den Zahlen hinter jedem Spiel."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
