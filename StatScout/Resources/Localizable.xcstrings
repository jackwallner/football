    "Per game. Team bars divide club totals by games played, and recent windows divide by the games in the window, so a bye or a Thursday game does not skew the comparison.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Per game. Team bars divide club totals by games played, and recent windows divide by the games in the window, so a bye or a Thursday game does not skew the comparison."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por partido. Las barras del equipo dividen el total entre los partidos jugados; los periodos recientes, entre los partidos del periodo. Así, una semana de descanso o un partido en jueves no distorsiona la comparación."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro Spiel. Die Team-Balken teilen die Gesamtwerte durch die absolvierten Spiele. Aktuelle Zeiträume teilen durch die Spiele im Zeitraum, damit eine Bye-Week oder ein Donnerstagsspiel den Vergleich nicht verzerrt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Per wedstrijd. Teambalken delen het totaal door de gespeelde wedstrijden; recente periodes delen door het aantal wedstrijden in die periode. Zo vertekent een bye of donderdagwedstrijd de vergelijking niet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per partita. Le barre della squadra dividono il totale per le partite giocate; gli intervalli recenti per le partite incluse. Così una bye week o una partita di giovedì non altera il confronto."
          }
        }
      }
    },
    "Percentage of attempts thrown into tight coverage, with a defender within one yard of the receiver.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Percentage of attempts thrown into tight coverage, with a defender within one yard of the receiver."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Porcentaje de intentos de pase a cobertura cerrada, con un defensivo a menos de una yarda del receptor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anteil der Würfe in enge Deckung, mit einem Verteidiger weniger als ein Yard vom Receiver entfernt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Percentage pogingen in strakke dekking, met een verdediger binnen één yard van de receiver."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Percentuale di lanci in copertura stretta, con un difensore a meno di un yard dal ricevitore."
          }
        }
      }
    },
