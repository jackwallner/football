    "Scores post when each game goes final, stats usually within a few hours. Follow a team from its page to pin its game here.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scores post when each game goes final, stats usually within a few hours. Follow a team from its page to pin its game here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El marcador aparece al final de cada partido y las estadísticas, unas horas después. Sigue a un equipo para fijar aquí sus partidos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ergebnisse erscheinen nach Spielende, Stats meist innerhalb weniger Stunden. Folge einem Team, um seine Spiele hier anzuheften."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scores verschijnen na afloop en statistieken meestal binnen een paar uur. Volg een team om wedstrijden hier vast te zetten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I punteggi arrivano a fine partita e le statistiche entro poche ore. Segui una squadra per fissare qui le sue partite."
          }
        }
      }
    },
    "Scores post when each game goes final. Player stats usually follow within a few hours.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scores post when each game goes final. Player stats usually follow within a few hours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los marcadores aparecen al final de cada partido. Las estadísticas de jugadores suelen llegar en unas horas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ergebnisse erscheinen nach Spielende. Spieler-Stats folgen meist innerhalb weniger Stunden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scores verschijnen na afloop van elke wedstrijd. Spelerstatistieken volgen meestal binnen een paar uur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I punteggi appaiono a fine partita. Le statistiche dei giocatori arrivano di solito entro poche ore."
          }
        }
      }
    },
    "Scores, leaders and movement across the league in seconds, with the numbers behind every game.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
