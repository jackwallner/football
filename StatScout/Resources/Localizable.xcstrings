    "Percentile rankings are not available for this player in the %lld season.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Percentile rankings are not available for this player in the %lld season."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay rankings por percentil de este jugador para la temporada %lld."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diesen Spieler gibt es in der Saison %lld keine Perzentil-Rangliste."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn geen percentielranglijsten voor deze speler in seizoen %lld."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non sono disponibili percentili per questo giocatore nella stagione %lld."
          }
        }
      }
    },
    "Percentile rankings compare a player to others at the same position. A 90th percentile means the player ranks in the top 10% of the league for that metric.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Percentile rankings compare a player to others at the same position. A 90th percentile means the player ranks in the top 10% of the league for that metric."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los percentiles comparan a un jugador con otros de la misma posición. Un percentil 90 significa que está entre el 10% mejor de la liga en esa métrica."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Perzentile vergleichen Spieler derselben Position. Das 90. Perzentil bedeutet, dass ein Spieler bei dieser Statistik zu den besten 10 % der Liga gehört."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Percentielen vergelijken een speler met anderen op dezelfde positie. Het 90e percentiel betekent dat de speler voor die statistiek bij de beste 10% van de league hoort."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I percentili confrontano un giocatore con gli altri dello stesso ruolo. Il 90° percentile significa che è tra i migliori 10% della lega in quella metrica."
          }
        }
      }
    },
    "Pick a player and season type to compare their aggregated stats across years.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a player and season type to compare their aggregated stats across years."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un jugador y el tipo de temporada para comparar sus estadísticas acumuladas entre años."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Spieler und eine Saisonphase, um seine Gesamtwerte über mehrere Jahre zu vergleichen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een speler en seizoensfase om totalen over meerdere jaren te vergelijken."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un giocatore e una fase stagionale per confrontare i totali tra gli anni."
          }
        }
      }
    },
