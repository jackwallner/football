    "%@, then %@. Auto-renews unless cancelled at least 24 hours before the end of the current period. Manage or cancel in Settings › Apple ID › Subscriptions.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, then %@. Auto-renews unless cancelled at least 24 hours before the end of the current period. Manage or cancel in Settings › Apple ID › Subscriptions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ y después %@. Se renueva automáticamente, salvo que canceles al menos 24 horas antes de que termine el periodo actual. Administra o cancela en Configuración › Apple ID › Suscripciones."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, danach %@. Verlängert sich automatisch, sofern du nicht mindestens 24 Stunden vor Ende des aktuellen Zeitraums kündigst. Verwalte oder kündige unter Einstellungen › Apple-ID › Abonnements."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ en daarna %@. Wordt automatisch verlengd, tenzij je minstens 24 uur voor het einde van de huidige periode opzegt. Beheer of zeg op via Instellingen › Apple ID › Abonnementen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, poi %@. Si rinnova automaticamente, salvo disdetta almeno 24 ore prima della fine del periodo in corso. Gestisci o annulla in Impostazioni › Apple ID › Abbonamenti."
          }
        }
      }
    },
