    "Advanced and standard stats for every club, a roster you can rank by any metric over any window, and side-by-side comparisons for every squad.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Advanced and standard stats for every club, a roster you can rank by any metric over any window, and side-by-side comparisons for every squad."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estadísticas avanzadas y tradicionales de cada equipo, plantillas ordenadas por métrica y periodo, y comparaciones entre equipos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erweiterte und Standard-Stats für jedes Team, Kader-Ranglisten nach Metrik und Zeitraum sowie Teamvergleiche."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geavanceerde en standaardstatistieken voor elke club, selecties gerangschikt op statistiek en periode, en vergelijkingen naast elkaar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Statistiche avanzate e standard per ogni squadra, roster ordinabili per metrica e periodo, e confronti affiancati."
          }
        }
      }
    },
