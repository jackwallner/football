    "Value rankings cover quarterbacks, running backs, receivers and tight ends for now.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Value rankings cover quarterbacks, running backs, receivers and tight ends for now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por ahora, la clasificación de valor incluye quarterbacks, corredores, receptores y tight ends."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wert-Rangliste umfasst derzeit Quarterbacks, Runningbacks, Receiver und Tight Ends."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De waarderanglijst omvat voorlopig quarterbacks, running backs, receivers en tight ends."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La classifica del valore include per ora quarterback, running back, ricevitori e tight end."
          }
        }
      }
    },
    "Values come from nflverse player statistics and NFL Next Gen Stats. Percentiles are calculated separately for each season and season type. The current season ranks everyone who has played; past seasons rank qualifying players.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Values come from nflverse player statistics and NFL Next Gen Stats. Percentiles are calculated separately for each season and season type. The current season ranks everyone who has played; past seasons rank qualifying players."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos vienen de nflverse y NFL Next Gen Stats. Los percentiles se calculan por temporada y fase. En la temporada actual se incluye a todos los que jugaron; en temporadas anteriores, solo a quienes califican."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Werte stammen aus nflverse und NFL Next Gen Stats. Perzentile werden je Saison und Phase berechnet. In der aktuellen Saison zählen alle Spieler mit Einsatz, früher nur qualifizierte Spieler."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gegevens komen uit nflverse en NFL Next Gen Stats. Percentielen worden per seizoen en fase berekend. Dit seizoen telt iedereen die speelde mee; eerdere seizoenen tonen gekwalificeerde spelers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati provengono da nflverse e NFL Next Gen Stats. I percentili sono calcolati per stagione e fase. Nella stagione attuale conta chiunque abbia giocato, in quelle passate solo i qualificati."
          }
        }
      }
    },
