    "Stats update after new source data is validated. Advanced metrics may arrive later than game totals. Not every metric is tracked for every player.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stats update after new source data is validated. Advanced metrics may arrive later than game totals. Not every metric is tracked for every player."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las estadísticas se actualizan cuando se validan nuevos datos. Las métricas avanzadas pueden tardar más que los totales del partido. No se registran todas las métricas para cada jugador."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stats werden aktualisiert, sobald neue Quelldaten geprüft sind. Erweiterte Werte können später eintreffen als Spielsummen. Nicht jede Metrik wird für jeden Spieler erfasst."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Statistieken worden bijgewerkt zodra nieuwe brongegevens zijn gecontroleerd. Geavanceerde statistieken kunnen later komen dan wedstrijdtotalen. Niet elke statistiek wordt voor elke speler bijgehouden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le statistiche si aggiornano dopo la verifica dei nuovi dati. Le metriche avanzate possono arrivare dopo i totali della partita. Non tutte le metriche sono tracciate per ogni giocatore."
          }
        }
      }
    },
