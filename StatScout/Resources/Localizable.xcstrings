    "Players under the playing-time minimum are hidden; View shows them.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Players under the playing-time minimum are hidden; View shows them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los jugadores debajo del mínimo de participación están ocultos. Puedes mostrarlos en Vista."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spieler unter der Mindestspielzeit sind ausgeblendet. Unter Ansicht kannst du sie einblenden."
