    "Not affiliated with, endorsed by, or sponsored by the National Football League, its teams, or the NFLPA. Team names and abbreviations are used for identification only. All trademarks are property of their respective owners.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not affiliated with, endorsed by, or sponsored by the National Football League, its teams, or the NFLPA. Team names and abbreviations are used for identification only. All trademarks are property of their respective owners."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin afiliación, respaldo ni patrocinio de la National Football League, sus equipos o la NFLPA. Los nombres y abreviaturas se usan solo para identificarlos. Todas las marcas pertenecen a sus titulares."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Verbindung, Unterstützung oder Förderung durch die National Football League, ihre Teams oder die NFLPA. Namen und Abkürzungen dienen nur der Identifikation. Alle Marken gehören ihren Eigentümern."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet verbonden aan, goedgekeurd door of gesponsord door de National Football League, haar teams of de NFLPA. Namen en afkortingen dienen alleen ter identificatie. Alle merken zijn eigendom van hun eigenaren."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non affiliato, approvato o sponsorizzato dalla National Football League, dalle sue squadre o dalla NFLPA. Nomi e abbreviazioni servono solo a identificarle. Tutti i marchi appartengono ai rispettivi proprietari."
          }
        }
      }
    },
