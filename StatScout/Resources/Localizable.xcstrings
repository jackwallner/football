    "Times the defender forced the quarterback to move off his spot or throw early without hitting him. 2018 onward.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Times the defender forced the quarterback to move off his spot or throw early without hitting him. 2018 onward."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Veces que el defensivo obligó al quarterback a moverse o lanzar antes, sin golpearlo. Desde 2018."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie oft der Verteidiger den Quarterback ohne Hit zum Ausweichen oder frühen Wurf zwang. Ab 2018."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe vaak de verdediger de quarterback liet verplaatsen of eerder gooien zonder hem te raken. Vanaf 2018."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Volte in cui il difensore ha costretto il quarterback a spostarsi o lanciare in anticipo senza colpirlo. Dal 2018."
          }
        }
      }
    },
