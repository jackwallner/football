    "Too early for movement: a %lld-week comparison starts in Week %lld. Until then, the best of the season so far.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too early for movement: a %lld-week comparison starts in Week %lld. Until then, the best of the season so far."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay suficientes semanas: la comparación de %lld semanas empieza en la semana %lld. Mientras tanto, lo mejor de la temporada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Trends ist es noch zu früh: Der %lld-Wochen-Vergleich beginnt in Woche %lld. Bis dahin die Saisonbesten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog te vroeg voor beweging: de vergelijking over %lld weken begint in week %lld. Tot die tijd zie je de besten van dit seizoen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È troppo presto per vedere variazioni: il confronto di %lld settimane parte dalla settimana %lld. Intanto, il meglio della stagione."
          }
        }
      }
    },
