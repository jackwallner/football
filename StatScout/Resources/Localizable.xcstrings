    "Track how every player ranked since 2000, plus the year-over-year trends behind today's leaders.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Track how every player ranked since 2000, plus the year-over-year trends behind today's leaders."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta la posición de cada jugador desde 2000 y las tendencias anuales detrás de los líderes de hoy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfolge die Ranglisten jedes Spielers seit 2000 und die Jahresentwicklung der heutigen Spitzenreiter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Volg de rangschikking van elke speler sinds 2000 en de jaartrends achter de koplopers van nu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segui la posizione di ogni giocatore dal 2000 e le tendenze annuali dietro ai leader di oggi."
          }
        }
      }
    },
