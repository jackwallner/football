    "Compare any player's percentile rankings across any two seasons. See what changed, what held, and where they're headed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare any player's percentile rankings across any two seasons. See what changed, what held, and where they're headed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compara los rankings por percentil de cualquier jugador entre dos temporadas. Mira qué cambió, qué se mantuvo y hacia dónde va."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergleiche die Perzentile eines Spielers über zwei Saisons. Sieh, was sich verändert hat und wie es weitergeht."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergelijk percentielen van een speler over twee seizoenen. Bekijk wat veranderde en wat eraan komt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Confronta i percentili di un giocatore tra due stagioni. Scopri cosa è cambiato e come procede."
