    "Season numbers tell you who's good. StatScout+ tells you who's good right now, and lets you prove it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Season numbers tell you who's good. StatScout+ tells you who's good right now, and lets you prove it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los números de temporada muestran quién es bueno. StatScout+ te dice quién está en su mejor momento y te deja comprobarlo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisonwerte zeigen, wer gut ist. StatScout+ zeigt dir, wer gerade liefert, und belegt es."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Seizoencijfers laten zien wie goed is. StatScout+ toont wie nu presteert en laat je dat zien."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I numeri stagionali dicono chi è bravo. StatScout+ mostra chi rende adesso, con i dati a confermarlo."
          }
        }
      }
    },
    "Season to date: totals per game, rates weighted by volume. Bars rank each club against the other 31.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Season to date: totals per game, rates weighted by volume. Bars rank each club against the other 31."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporada hasta hoy: totales por partido y tasas ponderadas por volumen. Las barras comparan cada equipo con los otros 31."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisonverlauf: Gesamtwerte pro Spiel, Raten nach Volumen gewichtet. Die Balken vergleichen jedes Team mit den anderen 31."
