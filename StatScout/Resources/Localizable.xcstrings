            "value": "Sueldo"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gehalt"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Salaris"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingaggio"
          }
        }
      }
    },
    "Pay is each deal's yearly average as a share of the cap when it was signed; production is the player's average percentile on the stats he qualifies for. Both are ranked among qualified %@ with a contract, and value is production minus pay. Contracts: OverTheCap via nflverse.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pay is each deal's yearly average as a share of the cap when it was signed; production is the player's average percentile on the stats he qualifies for. Both are ranked among qualified %@ with a contract, and value is production minus pay. Contracts: OverTheCap via nflverse."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sueldo es el promedio anual del contrato como porcentaje del tope salarial al firmarse. La producción es el percentil promedio en las estadísticas para las que el jugador califica. Ambos se comparan entre %@ calificados con contrato. El valor es producción menos sueldo. Contratos: OverTheCap vía nflverse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Gehalt ist der jährliche Vertragsdurchschnitt als Anteil des Salary Caps bei Vertragsabschluss. Die Leistung ist das durchschnittliche Perzentil der qualifizierten Stats. Beides wird unter %@ qualifizierten Spielern mit Vertrag verglichen. Wert ist Leistung minus Gehalt. Verträge: OverTheCap über nflverse."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het salaris is het jaargemiddelde van het contract als deel van de cap bij ondertekening. Productie is het gemiddelde percentiel voor statistieken waarvoor de speler kwalificeert. Beide worden vergeleken onder %@ gekwalificeerde spelers met contract. Waarde is productie min salaris. Contracten: OverTheCap via nflverse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ingaggio è la media annuale del contratto in rapporto al salary cap alla firma. La produzione è il percentile medio nelle statistiche per cui il giocatore è qualificato. Entrambi sono confrontati tra %@ qualificati con contratto. Il valore è produzione meno ingaggio. Contratti: OverTheCap via nflverse."
          }
        }
      }
    },
    "Pay ranks at the %@ percentile; production ranks at the %@ percentile among %@ qualified %@ with a contract. Contracts: OverTheCap via nflverse.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pay ranks at the %@ percentile; production ranks at the %@ percentile among %@ qualified %@ with a contract. Contracts: OverTheCap via nflverse."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sueldo está en el percentil %@; la producción en el %@ entre %@ %@ calificados con contrato. Contratos: OverTheCap vía nflverse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gehalt im %@. Perzentil, Leistung im %@. unter %@ qualifizierten %@ mit Vertrag. Verträge: OverTheCap über nflverse."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Salaris op percentiel %@, productie op %@ onder %@ gekwalificeerde %@ met contract. Contracten: OverTheCap via nflverse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingaggio al %@° percentile, produzione al %@° tra %@ %@ qualificati con contratto. Contratti: OverTheCap via nflverse."
          }
        }
      }
    },
    "Pay ranks at the %@ percentile; production ranks at the %@ percentile among %@ qualified %@ with a contract. Data through %@. Contracts: OverTheCap via nflverse.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pay ranks at the %@ percentile; production ranks at the %@ percentile among %@ qualified %@ with a contract. Data through %@. Contracts: OverTheCap via nflverse."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sueldo está en el percentil %@; la producción en el %@ entre %@ %@ calificados con contrato. Datos hasta %@. Contratos: OverTheCap vía nflverse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gehalt im %@. Perzentil, Leistung im %@. unter %@ qualifizierten %@ mit Vertrag. Stand %@. Verträge: OverTheCap über nflverse."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Salaris op percentiel %@, productie op %@ onder %@ gekwalificeerde %@ met contract. Gegevens tot %@. Contracten: OverTheCap via nflverse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingaggio al %@° percentile, produzione al %@° tra %@ %@ qualificati con contratto. Dati fino al %@. Contratti: OverTheCap via nflverse."
          }
        }
      }
    },
    "Pectoral": {
      "extractionState": "manual",
      "localizations": {
