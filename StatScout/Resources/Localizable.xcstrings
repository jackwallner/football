    "Ordered by win percentage, then point differential, not the NFL's full tiebreakers. PWR is the StatScout Power Rating: points better or worse than an average team on a neutral field.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordered by win percentage, then point differential, not the NFL's full tiebreakers. PWR is the StatScout Power Rating: points better or worse than an average team on a neutral field."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordenados por porcentaje de victorias y luego diferencia de puntos, no por todos los desempates de la NFL. PWR es el Power Rating de StatScout, puntos sobre o debajo de un equipo promedio en campo neutral."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sortiert nach Siegquote und Punktedifferenz, nicht nach allen NFL-Tiebreakern. PWR ist das StatScout Power Rating: Punkte über oder unter einem durchschnittlichen Team auf neutralem Feld."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerangschikt op winstpercentage en puntverschil, niet volgens alle NFL-tiebreakers. PWR is de StatScout Power Rating: punten beter of slechter dan een gemiddeld team op neutraal terrein."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordinate per percentuale di vittorie e differenza punti, non secondo tutti i criteri NFL. PWR è il Power Rating di StatScout: punti sopra o sotto una squadra media in campo neutro."
          }
        }
      }
    },
