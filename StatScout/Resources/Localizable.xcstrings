    "StatScout+ unlocks side-by-side player comparisons across every metric. See who leads in EPA, passing efficiency, separation, and more.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "StatScout+ unlocks side-by-side player comparisons across every metric. See who leads in EPA, passing efficiency, separation, and more."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "StatScout+ desbloquea comparaciones en cada métrica. Descubre quién lidera en EPA, eficiencia de pase, separación y más."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "StatScout+ schaltet Spielervergleiche für alle Metriken frei. Sieh, wer bei EPA, Pass-Effizienz und Separation vorne liegt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "StatScout+ ontgrendelt spelersvergelijkingen voor elke statistiek. Bekijk wie leidt in EPA, pasefficiëntie en separation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "StatScout+ sblocca confronti tra giocatori su ogni metrica. Scopri chi è in testa per EPA, efficienza nei passaggi e separation."
          }
        }
      }
    },
