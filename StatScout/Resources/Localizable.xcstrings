    "The Trends board, recent form, head-to-head matchups, and every season back to 2000. The full NFL picture on every player.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Trends board, recent form, head-to-head matchups, and every season back to 2000. The full NFL picture on every player."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tabla de tendencias, forma reciente, duelos cara a cara y todas las temporadas desde 2000. El panorama completo de cada jugador."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trends, aktuelle Form, Direktvergleiche und jede Saison seit 2000. Das ganze NFL-Bild jedes Spielers."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het Trends-bord, recente vorm, onderlinge duels en elk seizoen sinds 2000. Het complete NFL-beeld van elke speler."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trend, forma recente, confronti diretti e ogni stagione dal 2000. Il quadro NFL completo di ogni giocatore."
          }
        }
      }
    },
    "The Trends board: who's heating up and cooling off, league-wide": {
      "extractionState": "manual",
