# en-US only, deliberately.
#
# The `languages` list is what CREATES localizations in App Store Connect.
# Listing all 50 while only fastlane/metadata/en-US exists on disk creates 49
# EMPTY locales (blank description = submission blocker) and copies the en-US
# name/subtitle into each appInfo. That happened on 2026-07-29 and had to be
# cleaned up via the API.
#
# The full 50-language list lives in Deliverfile.all-locales. Swap it in only
# when fastlane/metadata/<locale>/ actually holds real football copy for every
# language in the list.
languages([
  "en-US"
])
